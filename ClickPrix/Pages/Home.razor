@page "/"
@using System.Globalization
@using ClickPrix.Models
@using ClickPrix.Services
@inject JolpicaClient Jolpica
@inject OpenF1Client OpenF1
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>ClickPrix — Qualifying Gaps by Ear</PageTitle>

<div class="cp">
    <header class="cp-header">
        <div class="cp-brand">
            <span class="cp-mark" aria-hidden="true"></span>
            <h1 class="cp-wordmark">CLICK<em>PRIX</em></h1>
        </div>
        <span class="cp-caption">QUALIFYING GAPS · BY EAR</span>
    </header>

    <section class="cp-hero">
        <p class="cp-eyebrow">// TIMING TOWER · LIVE</p>
        <h2 class="cp-headline">How close is Formula&nbsp;1, really?</h2>
        <p class="cp-lede">
            Every click you hear is one car crossing the finish line, in real time.
            The whole field arrives inside a heartbeat &mdash; press play and hear
            just how close it really is.
        </p>
    </section>

    <section class="cp-controls">
        <div class="cp-modes" role="group" aria-label="Session">
            @foreach (var s in Sessions)
            {
                <button class="cp-mode @(session == s ? "active" : null)"
                        disabled="@(!isLive)"
                        title="@(isLive ? null : "Session times need live data")"
                        @onclick="() => SelectSession(s)">
                    @(s == Session.Best ? "Best" : s.ToString())
                </button>
            }
        </div>

        <div class="cp-modes" role="group" aria-label="Chart view">
            <button class="cp-mode @(showMarkers ? "active" : null)" @onclick="() => showMarkers = true">
                Markers
            </button>
            <button class="cp-mode @(!showMarkers ? "active" : null)" @onclick="() => showMarkers = false">
                Highlight
            </button>
        </div>

        <button class="cp-play @(isPlaying ? "playing" : null)"
                disabled="@(loading || entries.Count == 0)"
                @onclick="TogglePlay">
            @(isPlaying ? "STOP" : "PLAY")
        </button>

        <div class="cp-readout">
            <span class="cp-readout-label">LATEST CROSSING</span>
            <span class="cp-readout-pos" id="cp-readout-pos">P&mdash; · READY</span>
            <span class="cp-readout-gap" id="cp-readout-gap">+0.000</span>
            <div class="cp-progress"><div class="cp-progress-fill" id="cp-progress-fill"></div></div>
        </div>
    </section>

    <section class="cp-chart @(showMarkers ? null : "no-lanes")">
        <div class="cp-chart-head">
            <span>@raceTitle</span>
            <span>Gap &rarr; line 🏁</span>
        </div>

        @if (loading)
        {
            <p class="cp-syncing">SYNCING TIMING DATA&hellip;</p>
        }
        else if (entries.Count == 0)
        {
            <p class="cp-syncing">NO TIMES SET IN THIS SESSION</p>
        }
        else
        {
            @for (var i = 0; i < entries.Count; i++)
            {
                var e = entries[i];
                <div class="cp-row" id="cp-row-@i" style="--team:@RowColor(e)">
                    <span class="cp-pos">@((i + 1).ToString("00"))</span>
                    <span class="cp-teambar" aria-hidden="true"></span>
                    <span class="cp-driver">
                        <span class="cp-code">@e.Code</span>
                        <span class="cp-teamname">@e.Team</span>
                    </span>
                    <span class="cp-lane">
                        <span class="cp-finish" aria-hidden="true"></span>
                        <span class="cp-pulse" id="cp-pulse-@i" aria-hidden="true"></span>
                        <span class="cp-marker" id="cp-marker-@i" style="left:@Pct(IdlePct(i))%"></span>
                    </span>
                    <span class="cp-gap @(i == 0 ? "pole" : null)">
                        @(i == 0 ? "POLE" : "+" + e.Gap.ToString("0.000", CultureInfo.InvariantCulture))
                    </span>
                </div>
            }
        }
    </section>

    <footer class="cp-footer">
        <span>SOUND REQUIRED &mdash; TURN IT UP</span>
        <a class="cp-footer-link" href="https://github.com/SixOThree/ClickPrix" target="_blank" rel="noopener">
            <svg class="cp-github-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.04-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.27-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.46-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
            </svg>
            GITHUB &nearr;
        </a>
        <span class="cp-source">
            <span>@(isLive && activeSource is not null ? $"LIVE · {SourceLabel(activeSource.Value)} API" : "ILLUSTRATIVE TIMING DATA")</span>
            @foreach (var s in Sources)
            {
                <button class="cp-source-btn @(source == s ? "active" : null)"
                        disabled="@loading"
                        @onclick="() => SelectSource(s)">
                    @SourceLabel(s)
                </button>
            }
        </span>
    </footer>
</div>

@code {
    private sealed record Entry(string Code, string Team, double Gap, string? Color = null);

    // ── Fallback dataset ────────────────────────────────────────────────
    // Used only when the Jolpica API is unreachable or has no results.
    // Gap is seconds to pole; order = result.
    private const string FallbackRaceTitle = "Belgian Grand Prix 2026 · Qualifying";

    private static readonly Entry[] FallbackGrid =
    {
        new("ANT", "Mercedes", 0.000),
        new("VER", "Red Bull", 0.317),
        new("NOR", "McLaren", 0.440),
        new("RUS", "Mercedes", 0.508),
        new("LEC", "Ferrari", 0.532),
        new("HAM", "Ferrari", 0.534),
        new("PIA", "McLaren", 0.655),
        new("LIN", "RB", 0.782),
        new("BOR", "Audi", 1.267),
        new("HAD", "Red Bull", 1.462),
        new("LAW", "RB", 1.759),
        new("GAS", "Alpine", 1.970),
        new("COL", "Alpine", 2.031),
        new("HUL", "Audi", 2.310),
        new("SAI", "Williams", 2.416),
        new("BEA", "Haas", 2.418),
        new("ALB", "Williams", 2.759),
        new("OCO", "Haas", 3.440),
        new("BOT", "Cadillac", 3.462),
        new("PER", "Cadillac", 3.610),
        new("ALO", "Aston Martin", 5.641),
        new("STR", "Aston Martin", 5.816),
    };

    private static readonly Dictionary<string, string> TeamColors = new()
    {
        ["Mercedes"] = "#27F4D2",
        ["Red Bull"] = "#3671C6",
        ["McLaren"] = "#FF8000",
        ["Ferrari"] = "#E8002D",
        ["RB"] = "#6692FF",
        ["Audi"] = "#009B77",
        ["Alpine"] = "#FF87BC",
        ["Williams"] = "#1CA0E0",
        ["Haas"] = "#B6BABD",
        ["Cadillac"] = "#C9A227",
        ["Aston Martin"] = "#229971",
    };

    private const string FallbackTeamColor = "#8b95a7";

    // The APIs use long team names; display the short forms.
    private static readonly Dictionary<string, string> TeamAliases = new()
    {
        // Jolpica (Ergast) constructor names
        ["RB F1 Team"] = "RB",
        ["Alpine F1 Team"] = "Alpine",
        ["Haas F1 Team"] = "Haas",
        ["Cadillac F1 Team"] = "Cadillac",
        // OpenF1 team names
        ["Red Bull Racing"] = "Red Bull",
        ["Racing Bulls"] = "RB",
    };

    // Our livery palette first; a source-provided color for teams the palette
    // doesn't know; grey as the last resort.
    private static string RowColor(Entry e) =>
        e.Color ?? TeamColors.GetValueOrDefault(e.Team, FallbackTeamColor);

    // ── Timing geometry ─────────────────────────────────────────────────
    // Playback is always real time: a car's click lands exactly its gap
    // after pole's. All markers share one velocity, so their spacing on
    // screen encodes the real gaps.
    private const double LeadInSeconds = 0.9;  // silence before the pole click
    private const double TailSeconds = 0.8;    // linger after the last car
    private const double FinishPct = 86.0;     // finish line position in the lane
    private const double IdleMinPct = 4.0;     // where the slowest car idles pre-launch
    private const double EndMaxPct = 95.0;     // markers coast to here after crossing

    private enum Session { Best, Q1, Q2, Q3 }

    private static readonly Session[] Sessions = { Session.Best, Session.Q1, Session.Q2, Session.Q3 };

    private enum DataSource { OpenF1, Jolpica }

    private static readonly DataSource[] Sources = { DataSource.OpenF1, DataSource.Jolpica };

    private static string SourceLabel(DataSource s) => s == DataSource.OpenF1 ? "OPENF1" : "JOLPICA";

    private bool loading = true;
    private bool isLive;
    private bool isPlaying;
    private bool showMarkers = true;
    private Session session = Session.Best;
    private DataSource source = DataSource.OpenF1; // fresher after a session; toggle in the footer
    private DataSource? activeSource;              // which source actually supplied the data
    private QualiData? data;
    private readonly Dictionary<DataSource, QualiData> sourceCache = new();
    private string raceTitle = FallbackRaceTitle;
    private List<Entry> entries = new();

    private IJSObjectReference? audioModule;
    private DotNetObjectReference<Home>? selfRef;

    // Cache buster for the audio module: the ModuleVersionId is a new GUID on
    // every build, so each deploy forces browsers to refetch audioClicks.js
    // instead of serving a stale cached copy with the old sounds.
    private static readonly string AssetVersion =
        typeof(Home).Assembly.ManifestModule.ModuleVersionId.ToString("N")[..8];

    private double Cross(int i) => LeadInSeconds + entries[i].Gap;
    private double MaxCross => entries.Count == 0 ? LeadInSeconds : Cross(entries.Count - 1);
    private double Velocity => (FinishPct - IdleMinPct) / MaxCross; // %/s, shared by all markers
    private double IdlePct(int i) => FinishPct - Velocity * Cross(i);

    private static string Pct(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;

        data = await FetchAsync(source);
        activeSource = data is not null ? source : null;

        // If the chosen source has nothing, quietly try the other one before
        // resorting to the baked-in fallback grid.
        if (data is null)
        {
            var other = source == DataSource.Jolpica ? DataSource.OpenF1 : DataSource.Jolpica;
            data = await FetchAsync(other);
            if (data is not null) activeSource = other;
        }

        isLive = data is not null && data.Drivers.Count > 0;
        raceTitle = isLive ? data!.Title : FallbackRaceTitle;
        RebuildEntries();
        loading = false;
    }

    private async Task<QualiData?> FetchAsync(DataSource s)
    {
        if (sourceCache.TryGetValue(s, out var cached)) return cached;

        var result = s == DataSource.Jolpica
            ? await Jolpica.GetLatestQualifyingDataAsync()
            : await OpenF1.GetLatestQualifyingAsync();

        // Only cache successes so a source that was down gets retried.
        if (result is not null) sourceCache[s] = result;
        return result;
    }

    private void RebuildEntries()
    {
        entries = isLive ? BuildEntries(data, session) : FallbackGrid.ToList();
    }

    private async Task SelectSource(DataSource s)
    {
        if (source == s) return;
        await StopPlaybackAsync();
        source = s;
        await LoadDataAsync();
    }

    private async Task SelectSession(Session s)
    {
        await StopPlaybackAsync();
        session = s;
        RebuildEntries();
    }

    private async Task StopPlaybackAsync()
    {
        if (isPlaying && audioModule is not null)
        {
            await audioModule.InvokeVoidAsync("stop");
            isPlaying = false;
        }
    }

    /// <summary>The chosen session's laps per driver, sorted, as gaps to that session's pole.
    /// Best = each driver's fastest across Q1-Q3; drivers with no time are excluded.</summary>
    private static List<Entry> BuildEntries(QualiData? data, Session session)
    {
        if (data is null) return new();

        var timed = new List<(QualiDriver D, double Seconds)>();
        foreach (var d in data.Drivers)
        {
            var secs = session switch
            {
                Session.Q1 => d.Q1,
                Session.Q2 => d.Q2,
                Session.Q3 => d.Q3,
                _ => new[] { d.Q1, d.Q2, d.Q3 }.Where(s => s is not null).Min(),
            };

            if (secs is not null) timed.Add((d, secs.Value));
        }

        timed.Sort((a, b) => a.Seconds.CompareTo(b.Seconds));
        if (timed.Count == 0) return new();

        var pole = timed[0].Seconds;
        return timed.Select(t =>
        {
            var team = TeamAliases.GetValueOrDefault(t.D.Team, t.D.Team);
            var color = TeamColors.TryGetValue(team, out var c) ? c : t.D.ApiColor;
            return new Entry(t.D.Code, team, t.Seconds - pole, color);
        }).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            audioModule = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/audioClicks.js?v={AssetVersion}");
            selfRef = DotNetObjectReference.Create(this);
        }
    }

    private async Task TogglePlay()
    {
        if (audioModule is null || entries.Count == 0) return;

        if (isPlaying)
        {
            await audioModule.InvokeVoidAsync("stop");
            isPlaying = false;
            return;
        }

        var total = MaxCross + TailSeconds;
        var v = Velocity;

        var items = entries.Select((e, i) =>
        {
            var cross = Cross(i);
            var idlePct = FinishPct - v * cross;
            var endPct = Math.Min(EndMaxPct, FinishPct + v * (total - cross));
            return new
            {
                code = e.Code,
                gap = e.Gap,
                cross,
                idlePct,
                endPct,
                durMs = (endPct - idlePct) / v * 1000.0,
            };
        }).ToArray();

        isPlaying = true;
        await audioModule.InvokeVoidAsync("play", items, total, showMarkers, selfRef);
    }

    [JSInvokable]
    public void OnPlaybackFinished()
    {
        isPlaying = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        if (audioModule is not null)
        {
            try
            {
                await audioModule.InvokeVoidAsync("stop");
                await audioModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
